# Variables de entorno para el microservicio sync-ligas-partidos-365score
# Copia este archivo como .env y llena los valores

# Supabase - almacen de ligas, partidos, equipos y standings
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave-anon-aqui

# Servidor
PUERTO=8003
HOST=127.0.0.1
CORS_ORIGEN=*

# Token de autorizacion para POST /api/sync y POST /api/sync-standings
SYNC_TOKEN=tu-token-secreto-aqui

# Token opcional para proteger GET /buscar-partido y GET /equivalencias (si no se define, son publicos)
# API_TOKEN=tu-token-api-aqui
